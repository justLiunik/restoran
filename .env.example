# Database configuration (connecting to Docker container mapped on port 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=kasir_restoran

# MySQL root password for Docker container (MUST equal DB_PASSWORD)
MYSQL_ROOT_PASSWORD=rootpass

# Application configuration
# Required, min. 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
